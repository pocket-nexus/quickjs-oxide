// The actual generic driver body is inserted from gc_kernel.rs. These are
// explicit adapter obligations, NOT proofs of WeakPass or Heap::drain.
use vstd::prelude::*;
mod model;
use model::{Graph, Work};

verus! {
pub trait EphemeronTrace {
    spec fn graph(&self) -> Graph;
    spec fn work(&self) -> Work;
    spec fn remaining(&self) -> nat;

    fn scan(&mut self) -> (more: bool)
        requires old(self).graph().valid(), old(self).work().valid(old(self).graph()),
            old(self).work().pending.is_empty(),
        ensures final(self).graph() == old(self).graph(), final(self).work().valid(final(self).graph()),
            final(self).remaining() == old(self).remaining(),
            !more ==> final(self).work().marked == final(self).graph().reachable(),
            !more ==> final(self).work().pending.is_empty(),
            more ==> !final(self).work().pending.is_empty();

    fn drain(&mut self)
        requires old(self).graph().valid(), old(self).work().valid(old(self).graph()),
            !old(self).work().pending.is_empty(),
        ensures final(self).graph() == old(self).graph(), final(self).work().valid(final(self).graph()),
            final(self).work().pending.is_empty(), final(self).remaining() < old(self).remaining();

    fn clear(&mut self)
        requires old(self).graph().valid(), old(self).work().valid(old(self).graph()),
            old(self).work().pending.is_empty(),
            old(self).work().marked == old(self).graph().reachable(),
        ensures final(self).graph() == old(self).graph(), final(self).work().marked == old(self).work().marked,
            final(self).work().pending.is_empty(), final(self).work().waiting.is_empty();
}

// DRIVER
pub fn main() {}
}
