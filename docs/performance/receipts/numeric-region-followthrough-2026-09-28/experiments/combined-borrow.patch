+    /// Read the product source and update its target under one state borrow.
+    /// The source Number is copied before the target is mutated, including for aliases.
+    pub(crate) fn try_add_array_product_own_numbers(
+        &self,
+        target: &JsValue,
+        index: u32,
+        source: &JsValue,
+        source_index: u32,
+        scale: Number,
+    ) -> Result<(), Miss> {
+        let JsValue::Object(source_id) = source else {
+            return Err(Miss::ReceiverNotObject);
+        };
+        let mut state = self
+            .0
+            .state
+            .try_borrow_mut()
+            .map_err(|_| Miss::HeapBorrowUnavailable)?;
+        let element = {
+            let data = state
+                .heap
+                .object(*source_id)
+                .map_err(|_| Miss::ReceiverUnavailable)?;
+            if !matches!(data.kind, ObjectKind::Array) {
+                return Err(Miss::ReceiverNotArray);
+            }
+            match &data.payload {
+                ObjectPayload::Array { dense: Some(dense) } => {
+                    match dense.get(source_index as usize) {
+                        Some(RawValue::Int(value)) => Number::Int(*value),
+                        Some(RawValue::Float(value)) => Number::Float(*value),
+                        Some(_) => return Err(Miss::OwnElementNotNumber),
+                        None => return Err(Miss::MissingOwnElement),
+                    }
+                }
+                ObjectPayload::Array { dense: None } => {
+                    materialized_array_own_number(&state, data, source_index)
+                        .ok_or(Miss::UnsupportedMaterializedOwnElement)?
+                }
+                _ => return Err(Miss::ArrayStorageUnavailable),
+            }
+        };
+        let JsValue::Object(target_id) = target else {
+            return Err(Miss::ReceiverNotObject);
+        };
+        let atom = Atom::from_immediate_integer(index).map(|atom| AtomIdx::from_raw(atom.raw()));
+        state
+            .heap
+            .try_add_array_own_number(*target_id, index, atom, element.mul(scale))
+    }
