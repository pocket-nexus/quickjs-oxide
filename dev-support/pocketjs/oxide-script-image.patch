+        .map_err(|_| oom(cx))?;
+    // The private binding becomes an ordinary data property at first use.
+    // Use one callable for both halves so a sealed global can still cache
+    // the copy and accept assignments through the installed setter.
+    let access = cx
+        .new_host_function(
+            "__pak",
+            0,
+            false,
+            &[Value::EMPTY],
+            Rc::new(move |cx, call| {
+                let setting = call.argc() != 0;
+                let receiver = if setting {
+                    call.this(cx).as_object().unwrap_or(global)
+                } else {
+                    global
+                };
+                let value = if setting {
+                    call.arg(cx, 0)
+                } else {
