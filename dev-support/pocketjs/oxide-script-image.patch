diff --git a/programs/linux-kms/examples/guest_compare/qjbc.rs b/programs/linux-kms/examples/guest_compare/qjbc.rs
new file mode 100644
index 00000000..9a01b6bf
--- /dev/null
+++ b/programs/linux-kms/examples/guest_compare/qjbc.rs
@@ -0,0 +1,110 @@
+use std::{
+    ffi::{c_char, c_int, c_void, CStr},
+    io,
+    ptr::NonNull,
+};
+
+use pocket_drivers::abi::{PocketGuestV1, PocketRuntime};
+use pocket_runtime::{
+    abi::CGuest, Guest as RuntimeGuest, GuestEnvironment, GuestFrame, OpContext, RuntimeError,
+};
+
+unsafe extern "C" {
+    fn pocket_guest_quickjs_create(profile: c_int) -> *mut c_void;
+    fn pocket_guest_quickjs_vtable() -> *const PocketGuestV1;
+    fn pocket_guest_quickjs_error(guest: *mut c_void) -> *const c_char;
+    fn pocket_guest_quickjs_set_engine_abi(guest: *mut c_void, abi: *const u8);
+    fn pocket_guest_quickjs_destroy(guest: *mut c_void);
+}
+
+/// Owns the exact C guest that implements PocketJS's QJBC loading. The
+/// caller installs it in the supplied runtime for the lifetime of the handle.
+pub(super) struct Guest {
+    guest: CGuest,
+    owner: NonNull<c_void>,
+}
+
+impl Guest {
+    pub(super) fn new(runtime: *mut PocketRuntime) -> io::Result<Self> {
+        const ABI: &[u8; 32] = include_bytes!(concat!(env!("OUT_DIR"), "/quickjs-abi"));
+        // The profile is POCKET_QJS_CANONICAL (0). All other pointers come
+        // from the C guest or are owned by the caller's live runtime handle.
+        unsafe {
+            let owner = NonNull::new(pocket_guest_quickjs_create(0))
+                .ok_or_else(|| io::Error::other("could not allocate C QuickJS guest"))?;
+            pocket_guest_quickjs_set_engine_abi(owner.as_ptr(), ABI.as_ptr());
+            match CGuest::new(pocket_guest_quickjs_vtable(), owner.as_ptr(), runtime) {
+                Ok(guest) => Ok(Self { guest, owner }),
+                Err(_) => {
+                    pocket_guest_quickjs_destroy(owner.as_ptr());
+                    Err(io::Error::other("could not register C QuickJS guest"))
+                }
+            }
+        }
+    }
+
+    pub(super) fn last_error(&self) -> Option<&str> {
+        // C owns the error text until the next mutable guest call.
+        let error = unsafe { pocket_guest_quickjs_error(self.owner.as_ptr()) };
+        if error.is_null() {
+            return None;
+        }
+        unsafe { CStr::from_ptr(error) }.to_str().ok()
+    }
+}
+
+impl Drop for Guest {
+    fn drop(&mut self) {
+        // The owner was allocated by pocket_guest_quickjs_create.
+        unsafe { pocket_guest_quickjs_destroy(self.owner.as_ptr()) };
+    }
+}
+
+impl RuntimeGuest for Guest {
+    fn initialize(
+        &mut self,
+        ops: OpContext,
+        env: &GuestEnvironment<'_>,
+    ) -> Result<(), RuntimeError> {
+        self.guest.initialize(ops, env)
+    }
+
+    fn evaluate(&mut self, _: &[u8]) -> Result<(), RuntimeError> {
+        Err(RuntimeError::UnsupportedOperation)
+    }
+
+    fn evaluate_bytecode(&mut self, envelope: &[u8]) -> Result<(), RuntimeError> {
+        self.guest.evaluate_bytecode(envelope)
+    }
+
+    fn frame(&mut self, frame: &GuestFrame<'_>) -> Result<(), RuntimeError> {
+        self.guest.frame(frame)
+    }
+
+    fn collect(&mut self) -> Result<(), RuntimeError> {
+        self.guest.collect()
+    }
+
+    fn shutdown(&mut self) {
+        self.guest.shutdown();
+    }
+}
+
+// The SDK archive exposes these same two functions at the C ABI boundary.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn pocket_runtime_supports_op(runtime: *const PocketRuntime, op: u16) -> u32 {
+    // Forward the C guest's borrowed runtime handle to the SDK implementation.
+    unsafe { pocket_runtime::abi::pocket_runtime_supports_op(runtime, op) }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn pocket_runtime_op(
+    runtime: *mut PocketRuntime,
+    op: u16,
+    args: *const c_void,
+    length: usize,
+    out: *mut pocket_drivers::abi::PocketResult,
+) -> i32 {
+    // Forward the borrowed arguments unchanged; the SDK validates their prefixes.
+    unsafe { pocket_runtime::abi::pocket_runtime_op(runtime, op, args, length, out) }
+}
