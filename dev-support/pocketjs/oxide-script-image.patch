new file mode 100644
index 00000000..df5409c1
--- /dev/null
+++ b/tools/packaging/compare-qjbc.ts
@@ -0,0 +1,44 @@
+// Diagnostic QJBC built with the PocketJS production compiler and envelope.
+// The native diagnostic ABI names the actual QuickJS-NG source/build; it is
+// deliberately distinct from the ESP-IDF ABI registered for deployment.
+import { createHash } from "node:crypto";
+import { dirname } from "node:path";
+import { decodePocketPackage, encodePocketPackage, POCKET_SECTION } from "../../contracts/spec/pocket-package.ts";
+import { engineAbiDigest, ESP_IDF_QUICKJS_NG_0_14_0 } from "../../contracts/spec/quickjs-bytecode.ts";
+import { compileQuickJsBytecode } from "../quickjs-bytecode.ts";
+
+const [input, target, source, version, bytecodeVersion, output, digest] = Bun.argv.slice(2);
+if (!input || !target || !source || !version || !bytecodeVersion || !output || !digest) {
+  console.error("usage: bun tools/packaging/compare-qjbc.ts INPUT.pocket TARGET QUICKJS_SOURCE VERSION BC_VERSION OUTPUT.pocket ABI.bin");
+  process.exit(2);
+}
+const pkg = decodePocketPackage(await Bun.file(input).bytes());
+const variant = pkg.variants.find((entry) => entry.target === target);
+if (!variant) throw new Error(`package has no ${target} variant`);
+const js = variant.sections.find((section) => section.kind === POCKET_SECTION.js)?.bytes;
+if (!js?.length || js.at(-1) !== 0) throw new Error("package has no NUL-terminated UI bundle");
+if (process.platform !== "linux" || process.arch !== "x64") throw new Error("expected a Linux x64 diagnostic host");
+
+const hash = createHash("sha256");
+for (const file of ["quickjs.h", "quickjs.c", "dtoa.c", "libregexp.c", "libunicode.c"]) {
+  hash.update(await Bun.file(`${source}/${file}`).bytes());
+}
+const reference = ESP_IDF_QUICKJS_NG_0_14_0.descriptor;
+const descriptor = {
+  ...reference,
+  binding: { ...reference.binding, name: "linux-diagnostic", version, checksum: hash.digest("hex"), revision: "local" },
+  engine: { ...reference.engine, version, revision: "local", bytecodeVersion: Number(bytecodeVersion) },
+  build: { ...reference.build, pointerWidth: 64 as const, valueRepresentation: "tagged-struct" as const },
+};
+const abi = { name: "linux-qjbc-compare", descriptor, canonicalDescriptor: "", sha256: engineAbiDigest(descriptor) };
+const compiled = compileQuickJsBytecode(abi, js.subarray(0, -1), {
+  engineSource: { abi, directory: source },
+  buildDirectory: dirname(digest),
+});
+if (compiled.bytecode[0] !== Number(bytecodeVersion)) throw new Error("QuickJS bytecode version mismatch");
+variant.sections = variant.sections.filter(({kind}) => kind !== POCKET_SECTION.js &&
+  kind !== POCKET_SECTION.bytecode && kind !== POCKET_SECTION.oxideBytecode);
+variant.sections.push({ kind: POCKET_SECTION.bytecode, bytes: compiled.section });
+await Bun.write(output, encodePocketPackage(pkg));
+await Bun.write(digest, Buffer.from(abi.sha256.slice(7), "hex"));
+console.log(`${output}: ${compiled.section.length} byte QJBC section, ABI ${abi.sha256}`);
diff --git a/tools/packaging/compile-oxide.ts b/tools/packaging/compile-oxide.ts
new file mode 100644
index 00000000..9e5b16fb
--- /dev/null
+++ b/tools/packaging/compile-oxide.ts
@@ -0,0 +1,41 @@
+// Compile the exact UI section of an existing .pocket, preserving its plan and assets.
+import { mkdtempSync, rmSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { decodePocketPackage, encodePocketPackage, POCKET_SECTION, verifyOxideBytecodeEnvelope } from "../../contracts/spec/pocket-package.ts";
+
+const [compiler, input, target, output, mode, ...extra] = Bun.argv.slice(2);
+if (!compiler || !input || !target || !output || (mode && mode !== "--oxide-only") || extra.length) {
+  console.error("usage: bun tools/packaging/compile-oxide.ts COMPILER INPUT.pocket TARGET OUTPUT.pocket [--oxide-only]");
+  process.exit(2);
+}
+
+const pkg = decodePocketPackage(await Bun.file(input).bytes());
+const variant = pkg.variants.find((entry) => entry.target === target);
+if (!variant) throw new Error(`package has no ${target} variant`);
+const js = variant.sections.find((section) => section.kind === POCKET_SECTION.js)?.bytes;
+if (!js?.length || js.at(-1) !== 0) throw new Error("package has no NUL-terminated UI bundle");
+if (mode === "--oxide-only" && variant.sections.some(({kind}) =>
+  kind === POCKET_SECTION.workerJs || kind === POCKET_SECTION.workerBytecode)) {
+  throw new Error("the Oxide-only guest cannot start a packaged worker");
+}
+const scratch = mkdtempSync(join(dirname(output), ".oxide-build-"));
+try {
+  const source = join(scratch, "app.js");
+  const image = join(scratch, "app.oxbc");
+  await Bun.write(source, js.subarray(0, -1));
+  const result = Bun.spawnSync([compiler, "--strip-source", source, image], { stderr: "inherit" });
+  if (result.exitCode !== 0) throw new Error(`Oxide compiler exited ${result.exitCode}`);
+  const bytes = await Bun.file(image).bytes();
+  verifyOxideBytecodeEnvelope(bytes);
+  const drop = new Set<number>([POCKET_SECTION.oxideBytecode]);
+  if (mode === "--oxide-only") {
+    drop.add(POCKET_SECTION.js);
+    drop.add(POCKET_SECTION.bytecode);
+  }
+  variant.sections = variant.sections.filter(({kind}) => !drop.has(kind));
+  variant.sections.push({ kind: POCKET_SECTION.oxideBytecode, bytes });
+  await Bun.write(output, encodePocketPackage(pkg));
+  console.log(`${output}: ${bytes.length} byte Oxide image for ${target}`);
+} finally {
+  rmSync(scratch, { recursive: true, force: true });
+}
