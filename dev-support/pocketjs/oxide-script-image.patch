+#[cfg(feature = "qjbc-compare")]
+fn build_quickjs() {
+    use std::{env, path::PathBuf};
+    let source = PathBuf::from(
+        env::var_os("POCKETJS_QUICKJS_SOURCE")
+            .expect("set POCKETJS_QUICKJS_SOURCE to the QuickJS-NG source directory"),
+    );
+    let abi = PathBuf::from(
+        env::var_os("POCKETJS_QUICKJS_ABI")
+            .expect("set POCKETJS_QUICKJS_ABI to the binary, 32-byte compiler ABI digest"),
+    );
+    println!("cargo:rerun-if-env-changed=POCKETJS_QUICKJS_SOURCE");
+    println!("cargo:rerun-if-env-changed=POCKETJS_QUICKJS_ABI");
+    println!("cargo:rerun-if-changed={}", abi.display());
+    let digest = std::fs::read(&abi).expect("read QuickJS-NG ABI digest");
+    assert_eq!(digest.len(), 32);
+    let out = PathBuf::from(env::var_os("OUT_DIR").unwrap());
+    std::fs::write(out.join("quickjs-abi"), digest).unwrap();
+
+    let mut cc = cc::Build::new();
+    cc.std("gnu11")
+        .warnings(false)
+        .define("_GNU_SOURCE", None)
+        .define("QUICKJS_NG_BUILD", None)
+        .flag("-fno-strict-aliasing")
+        .include(&source)
+        .include("../../engine/guest-quickjs/include")
+        .include("../../contracts/generated")
+        .file("../../engine/guest-quickjs/src/guest.c");
+    for name in ["quickjs.c", "dtoa.c", "libregexp.c", "libunicode.c"] {
+        let file = source.join(name);
+        println!("cargo:rerun-if-changed={}", file.display());
+        cc.file(file);
+    }
+    cc.compile("pocket_qjbc_compare");
+    println!("cargo:rustc-link-lib=m");
 }
